# Environment Configuration Template
# Copy this file to .env and replace values with your actual configuration
# DO NOT commit the .env file with actual credentials to version control

# ============================================
# Database Configuration (SAP HANA)
# ============================================
# Get these values from your HANA Cloud instance in BTP Cockpit
DB_HOST=your-hana-host.hanacloud.ondemand.com
DB_PORT=443
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_SCHEMA=your_db_schema

# ============================================
# SSC V2 Integration
# ============================================
# Destination name configured in BTP Cockpit for SSC V2 API access
SSC_DESTINATION=your-ssc-destination-name

# ============================================
# Application Configuration
# ============================================
# Application port (default: 8080)
PORT=8080

# Environment mode (development, production)
NODE_ENV=development

