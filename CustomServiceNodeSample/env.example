# Environment Configuration Template
# Copy this file to .env and replace values with your actual configuration
# DO NOT commit the .env file with actual credentials to version control

# ============================================
# Database Configuration (SAP HANA)
# ============================================
# Get these values from your HANA Cloud instance in BTP Cockpit
DB_HOST=your-hana-host.hanacloud.ondemand.com
DB_PORT=443
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_SCHEMA=your_db_schema

# ============================================
# SSC V2 Integration
# ============================================
# Destination name configured in BTP Cockpit for SSC V2 API access
SSC_DESTINATION=your-ssc-destination-name

# ============================================
# Analytics Integration (optional)
# ============================================
# Required only if using analytics event reporting.
# Leave empty or omit to disable analytics (service will work normally).

# The source ID of your SSC tenant registered in the analytics system
# Found in your analytics pipeline configuration
SSC_TENANT_SOURCE_ID=your-ssc-tenant-source-id

# BTP Destination name pointing to the SSC tenant's analytics inbound connector
# Configure this destination in BTP Cockpit with the SSC tenant URL and credentials
SSC_ANALYTICS_DESTINATION=your-ssc-analytics-destination-name

# ============================================
# Application Configuration
# ============================================
# Application port (default: 8080)
PORT=8080

# Environment mode (development, production)
NODE_ENV=development

# ============================================
# Local Development Only (do not set in production)
# ============================================
# USE_TEST_TOKEN=false
# TEST_JWT_TOKEN=
# DEV_TENANT_ID=dev-tenant
